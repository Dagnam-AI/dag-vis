node_modules/
dist/
coverage/
*.tgz
.DS_Store
# Agent worktrees are created BESIDE the repo (../dag-vis--<slug>), never inside.
.claude/
# Playwright output and the sign-off screenshots (artifacts, never committed).
screenshots/
fidelity/
playwright-report/
test-results/
# motion/ renders and generated assets never enter the public history
motion/node_modules/
motion/out/
motion/public/fonts/
motion/public/generated/

# local secrets (for example motion/.env with the R2 videos token) never enter the public history
.env
.env.*
!.env.example
