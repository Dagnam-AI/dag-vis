{
  "name": "@dagnam/vis",
  "version": "0.1.2",
  "description": "Deterministic, parameterised Dagnam.AI visuals: brand tokens, gradients, patterns, OG cards and favicons — browser, React and Node.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dagnam-AI/dag-vis.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./animate": {
      "types": "./dist/animate/index.d.ts",
      "default": "./dist/animate/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dag-vis": "./bin/dag-vis.mjs"
  },
  "files": [
    "dist",
    "bin",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/node/fonts && cp -R src/node/fonts/. dist/node/fonts/ && node scripts/vendor-muxers.mjs",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run typecheck:demo && npm run check:motion",
    "check:motion": "node scripts/check-motion.mjs",
    "demo": "vite demo",
    "test:e2e": "playwright test",
    "fidelity": "playwright test -c playwright.fidelity.config.ts && echo 'open fidelity/index.html'",
    "typecheck:demo": "tsc -p demo/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "mp4-muxer": "5.2.2",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webm-muxer": "5.1.4"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "gifenc": "1.0.3"
  }
}
